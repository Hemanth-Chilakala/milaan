# Copy to .env only for an existing Exasol deployment.
# The local deployment check writes this securely for a new installation.
EXASOL_DSN=127.0.0.1/FINGERPRINT:8563
EXASOL_USER=sys
EXASOL_PASSWORD=replace-with-deployment-secret
# No inference API key is required or used.
# Reserved for a future optional extension; not enabled in this release:
# LLM_PROVIDER=
# LLM_API_KEY=
